{
  "name": "DocSend & SharePoint Deck Downloader",
  "version": "3.0",
  "description": "Download DocSend slide decks and SharePoint / OneDrive documents as a PDF",
  "permissions": ["declarativeNetRequestWithHostAccess", "scripting"],
  "host_permissions": [
    "*://*.docsend.com/*",
    "*://*.cloudfront.net/*",
    "*://*.docsend.dropbox.com/*",
    "*://*.sharepoint.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "Download this document as a PDF"
  },
  "icons": {
    "16": "./assets/icon16.png",
    "48": "./assets/icon48.png",
    "128": "./assets/icon128.png"
  },
  "manifest_version": 3
}
